generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  quota     Int      @default(15)
  createdAt DateTime @default(now())
  cases     DivinationCase[]
  sessions  DivinationSession[]
  caseRelations CaseRelation[]
  note      UserNote?
  agentTurns AgentTurn[]
  agentToolRuns AgentToolRun[]
  ziweiFengshuiAnalyses ZiweiFengshuiAnalysis[]
  agentLockUntil DateTime?
  agentLockTurnId String?
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String    @default("registration")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([email, expiresAt])
  @@index([email, purpose, createdAt])
}

model SiteSettings {
  id                        String   @id @default("global")
  announcementTitle         String
  announcementUpdatedAt     String
  announcementItems         String[] @default([])
  announcementContent       String   @default("")
  welcomeIntro              String   @default("")
  registrationEnabled       Boolean  @default(true)
  registrationClosedContact String   @default("微信：zixu9498422")
  guestModeEnabled          Boolean  @default(true)
  fortuneAlgorithmMode      String   @default("default")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model DivinationCase {
  id         String   @id @default(cuid())
  userId     String
  modelType  String
  title      String
  chartParams Json?
  chartData  Json?
  klineData  Json?
  initialAnalysisData Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions   DivinationSession[]
  relationLinksA CaseRelation[] @relation("CaseRelationA")
  relationLinksB CaseRelation[] @relation("CaseRelationB")
  ziweiFengshuiAnalyses ZiweiFengshuiAnalysis[]

  @@index([userId, modelType, updatedAt])
}

model ZiweiFengshuiAnalysis {
  id               String   @id @default(cuid())
  userId           String
  caseId           String
  targetYear       Int
  chartFingerprint String
  promptVersion    String
  status           String   @default("pending")
  result           Json?
  lastError        String?
  pointReserved    Boolean  @default(false)
  generatedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  divinationCase   DivinationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, targetYear, chartFingerprint, promptVersion])
  @@index([userId, caseId, targetYear])
  @@index([status, updatedAt])
}

model CaseRelation {
  id          String   @id @default(cuid())
  userId      String
  caseAId     String
  caseBId     String
  labelAToB   String?
  labelBToA   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseA       DivinationCase @relation("CaseRelationA", fields: [caseAId], references: [id], onDelete: Cascade)
  caseB       DivinationCase @relation("CaseRelationB", fields: [caseBId], references: [id], onDelete: Cascade)

  @@index([userId, caseAId])
  @@index([userId, caseBId])
}

model DivinationSession {
  id          String   @id @default(cuid())
  userId      String
  caseId      String?
  modelType   String
  title       String
  chartParams Json?
  chartData   Json?
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  divinationCase DivinationCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  agentTurns  AgentTurn[]
  agentToolRuns AgentToolRun[]

  @@index([caseId, updatedAt])
  @@index([userId, isPinned, updatedAt])
  @@index([userId, isArchived, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  knowledgeSources Json?
  agentTurnId String?
  metadata  Json?
  createdAt DateTime @default(now())
  session   DivinationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentTurn AgentTurn? @relation(fields: [agentTurnId], references: [id], onDelete: SetNull)

  @@index([agentTurnId, createdAt])
}

model AgentTurn {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  status      String   @default("running")
  aiCallCount Int      @default(0)
  pointsUsed  Int      @default(0)
  matterKey   String?
  clarification Json?
  errorCode   String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     DivinationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  toolRuns    AgentToolRun[]

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model AgentToolRun {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String
  turnId        String
  toolCallId    String?
  toolName      String
  status        String   @default("running")
  input         Json
  resultSummary String?
  resultText    String?
  rawResult     Json?
  errorCode     String?
  matterKey     String?
  divinationMode String?
  timeBucketKey String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       DivinationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn          AgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([userId, timeBucketKey, divinationMode])
  @@index([sessionId, startedAt])
  @@index([turnId, startedAt])
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
