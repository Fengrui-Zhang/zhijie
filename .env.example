# === 数据库 (必填) ===
# Vercel + Neon 会自动注入 DATABASE_URL 和 DATABASE_URL_UNPOOLED
# 本地开发请填写本地 PostgreSQL 连接串
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# === NextAuth 认证 (必填) ===
# 用于 JWT 签名，可通过 openssl rand -base64 32 生成
NEXTAUTH_SECRET=
# 应用 URL（生产环境改为实际域名）
NEXTAUTH_URL=

# === DeepSeek API (必填) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认启用；设为 false 可让“问智解”回退到原直接聊天链路
AGENT_CHAT_ENABLED=true

# === 知识库 Embedding (可选，不填则使用 DEEPSEEK_API_KEY) ===
# DashScope: EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com 会自动使用 compatible-mode
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# === 知识库检索 (可选) ===
USE_HIER_KNOWLEDGE=

# === 邮箱验证码与密码重置 (启用注册邮件时必填) ===
RESEND_API_KEY=
EMAIL_FROM=
# 可选；未填写时回落到 NEXTAUTH_SECRET
EMAIL_CODE_SECRET=

# === 管理员种子账号 (运行 npm run seed 时使用) ===
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# === Vercel Cron (生产环境必填，用于会话清理) ===
# 可通过 openssl rand -hex 32 生成，需与 Vercel 项目环境变量一致
CRON_SECRET=
